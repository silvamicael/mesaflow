# API local — não expor este servidor diretamente à internet
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL do Compose na raiz do projeto
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=mesaflow
DB_USER=mesaflow_dev
# Use no .env a mesma senha configurada no .env da raiz
DB_PASSWORD=substitua_pela_senha_do_banco_local

# Execute npm run auth:setup --prefix backend para gerar o segredo no .env
JWT_SECRET=
JWT_EXPIRES_SECONDS=3600

# Somente para npm run admin:create; remova ADMIN_SENHA após a criação
ADMIN_NOME=
ADMIN_EMAIL=
ADMIN_SENHA=
