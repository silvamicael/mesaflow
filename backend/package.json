{
  "name": "mesaflow-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API do MesaFlow — base de desenvolvimento",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
